    {
      "id": "de_long_01",
      "class": "longer",
      "index": 91,
      "text": "Am frühen Dienstag fährt Lena mit dem Fahrrad zur Arbeit und nimmt unterwegs eine warme Brezel beim Bäcker.",
      "word_count": 18
    },
    {
      "id": "de_long_02",
      "class": "longer",
      "index": 92,
      "text": "Wenn der Zug um halb acht ankommt, wartet Markus am Bahnsteig und ruft seine Schwester kurz an.",
      "word_count": 17
    },
    {
      "id": "de_long_03",
      "class": "longer",
      "index": 93,
      "text": "Bitte öffne das Fenster vorsichtig, denn draußen weht ein kalter Wind und die nassen Blätter liegen überall.",
      "word_count": 17
    },
    {
      "id": "de_long_04",
      "class": "longer",
      "index": 94,
      "text": "Im kleinen Café bestellt Nora einen Espresso, ein Käsebrötchen und später noch ein Glas Wasser ohne Eis.",
      "word_count": 17
    },
    {
      "id": "de_long_05",
      "class": "longer",
      "index": 95,
      "text": "Der neue Computer startet langsam, deshalb prüft David das Kabel, lädt den Akku und speichert seine Arbeit.",
      "word_count": 17
    },
    {
      "id": "de_long_06",
      "class": "longer",
      "index": 96,
      "text": "Nach dem Gewitter scheint wieder die Sonne, doch auf der Straße bleiben tiefe Pfützen und glänzende Steine.",
      "word_count": 17
    },
    {
      "id": "de_long_07",
      "class": "longer",
      "index": 97,
      "text": "Im Deutschkurs liest Sophie einen kurzen Text über München und erklärt danach, warum manche Wörter anders klingen.",
      "word_count": 17
    },
    {
      "id": "de_long_08",
      "class": "longer",
      "index": 98,
      "text": "Für das Wochenende packen wir warme Jacken, zwei Bücher und eine kleine Kamera für den Ausflug ein.",
      "word_count": 17
    },
    {
      "id": "de_long_09",
      "class": "longer",
      "index": 99,
      "text": "Kannst du bitte die blaue Schachtel neben der Lampe holen und anschließend auf den Tisch stellen?",
      "word_count": 16
    },
    {
      "id": "de_long_10",
      "class": "longer",
      "index": 100,
      "text": "Am Sonntag besucht Jonas seine Großmutter, bringt frisches Obst mit und hört ihr geduldig beim Erzählen zu.",
      "word_count": 17
    }
